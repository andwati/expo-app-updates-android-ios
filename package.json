{
  "name": "expo-app-updates-android-ios",
  "version": "0.1.2",
  "description": "in app updates for ios and android",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "tsc --build --clean",
    "lint": "biome check --error-on-warnings .",
    "test": "jest",
    "prepare": "tsc",
    "open:ios": "node internal/module_scripts/open-ios.ts",
    "open:android": "node internal/module_scripts/open-android.ts",
    "typecheck": "tsc --noEmit && tsc -p internal/tsconfig.json && tsc -p src/__tests__/tsconfig.json && tsc -p example/tsconfig.json",
    "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm test --runInBand",
    "prepack": "pnpm verify"
  },
  "keywords": ["react-native", "expo", "expo-app-updates-android-ios", "ExpoAppUpdatesAndroidIos"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andwati/expo-app-updates-android-ios.git"
  },
  "bugs": {
    "url": "https://github.com/andwati/expo-app-updates-android-ios/issues"
  },
  "author": "andwati <andwatiian@gmail.com> (https://github.com/andwati)",
  "license": "MIT",
  "homepage": "https://github.com/andwati/expo-app-updates-android-ios#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@biomejs/biome": "2.6.9",
    "@react-native/jest-preset": "0.88.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.22",
    "expo": "^58.0.21",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.13",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": ["<rootDir>/src"]
  },
  "peerDependencies": {
    "expo": "^58.0.0",
    "react": "^19.0.0",
    "react-native": "~0.88.0"
  }
}
