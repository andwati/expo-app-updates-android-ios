{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "ignoreUnknown": false },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    "attributePosition": "auto",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "expand": "auto",
    "useEditorconfig": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "complexity": {
        "noArguments": "warn",
        "noCommaOperator": "warn",
        "noExtraBooleanCast": "warn",
        "noUselessConstructor": "warn",
        "noUselessEscapeInRegex": "warn",
        "noUselessLoneBlockStatements": "warn",
        "noUselessRename": "warn",
        "noUselessStringConcat": "warn",
        "noUselessTernary": "warn",
        "useLiteralKeys": "warn"
      },
      "correctness": {
        "noConstAssign": "error",
        "noConstantCondition": "warn",
        "noEmptyCharacterClassInRegex": "warn",
        "noEmptyPattern": "warn",
        "noGlobalObjectCalls": "warn",
        "noInnerDeclarations": "warn",
        "noInvalidBuiltinInstantiation": "error",
        "noInvalidConstructorSuper": "warn",
        "noSelfAssign": "warn",
        "noSwitchDeclarations": "warn",
        "noUndeclaredVariables": "error",
        "noUnreachable": "warn",
        "noUnreachableSuper": "warn",
        "noUnusedInstantiation": "warn",
        "noUnusedLabels": "warn",
        "noUnusedVariables": {
          "level": "warn",
          "options": { "ignoreRestSiblings": true, "ignoreUsingDeclarations": false }
        },
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error",
        "useIsNan": "error",
        "useParseIntRadix": "warn",
        "useValidTypeof": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      },
      "performance": { "noDelete": "error" },
      "security": { "noGlobalEval": "warn", "noScriptUrl": "warn" },
      "style": {
        "noNonNullAssertion": "error",
        "noYodaExpression": "warn",
        "useImportType": "error",
        "useArrayLiterals": "warn",
        "useBlockStatements": "warn",
        "useConsistentArrowReturn": "off",
        "useConst": "warn",
        "useFragmentSyntax": "warn",
        "useImportsFirst": "warn",
        "useSelfClosingElements": "warn",
        "useSpreadOverApply": "warn"
      },
      "suspicious": {
        "noAlert": "off",
        "noCatchAssign": "warn",
        "noCompareNegZero": "warn",
        "noControlCharactersInRegex": "off",
        "noDebugger": "warn",
        "noDoubleEquals": { "level": "warn", "options": { "ignoreNull": true } },
        "noDuplicateCase": "error",
        "noDuplicateClassMembers": "error",
        "noDuplicateJsxProps": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateParameters": "error",
        "noExplicitAny": "error",
        "noFallthroughSwitchClause": "warn",
        "noFunctionAssign": "error",
        "noGlobalAssign": "warn",
        "noIrregularWhitespace": "warn",
        "noLabelVar": "warn",
        "noOctalEscape": "warn",
        "noProto": "warn",
        "noRedeclare": "warn",
        "noReturnAssign": "warn",
        "noSelfCompare": "warn",
        "noShadowRestrictedNames": "warn",
        "noSparseArray": "warn",
        "noUnknownAttribute": "warn",
        "noUnsafeNegation": "warn",
        "noUnusedExpressions": "warn",
        "noVar": "warn",
        "noWith": "warn",
        "useGetterReturn": "warn"
      }
    },
    "includes": ["**", "!build", "**", "!build"]
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "quoteStyle": "single",
      "attributePosition": "auto",
      "bracketSpacing": true
